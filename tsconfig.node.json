{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@pakti/types": ["./packages/types/src/index.ts"],
      "@pakti/shared": ["./packages/shared/src/index.ts"],
      "@pakti/shared/defaults": ["./packages/shared/src/defaults.ts"],
      "@pakti/shared/exporters": ["./packages/shared/src/exporters.ts"],
      "@pakti/shared/recordings": ["./packages/shared/src/recordings.ts"],
      "@pakti/shared/systemConfig": ["./packages/shared/src/systemConfig.ts"],
      "@pakti/shared/videoPath": ["./packages/shared/src/videoPath.ts"],
      "@pakti/api-client": ["./packages/api-client/src/index.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
