{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "Default permissions for PackCam",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-remove",
    "fs:allow-mkdir",
    "sql:allow-close",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute"
  ]
}
