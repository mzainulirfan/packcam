{
  "name": "pakti",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev-full.mjs",
    "dev:lan": "node scripts/dev-full.mjs",
    "dev:web": "npm run dev -w @pakti/web -- --host 0.0.0.0",
    "dev:backend": "npm run dev -w @pakti/backend",
    "dev:mobile": "npm run dev -w @pakti/mobile",
    "api:dev": "npm run dev:backend",
    "api:start": "npm run start -w @pakti/backend",
    "migrate:videos": "node scripts/migrate-video-storage.mjs",
    "clean:build": "node scripts/clean-build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:unit": "tsx scripts/unit-shared.ts",
    "test:web": "tsx scripts/unit-web-scanner.ts",
    "prebuild": "npm run clean:build",
    "build": "tsc -b && vite build",
    "build:vercel": "npm run build && npm run build -w @pakti/mobile -- --base /mobile/ --outDir ../../dist/mobile",
    "build:mobile:vercel": "npm run build -w @pakti/mobile -- --base / --outDir ../../dist-mobile",
    "build:mobile": "npm run build -w @pakti/mobile",
    "deploy:mobile:vercel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-mobile-vercel.ps1",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:mobile": "npm run preview -w @pakti/mobile"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@zxing/browser": "^0.2.0",
    "better-sqlite3": "^12.10.0",
    "boxicons": "^2.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.16.0",
    "multer": "^2.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.7.0",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
